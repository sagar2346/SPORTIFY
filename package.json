{
  "name": "online-sport-booking-system",
  "version": "1.0.0",
  "description": "Complete MERN stack application for booking sports venues",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon backend/server.js",
    "client": "cd frontend && npm start",
    "install-server": "cd backend && npm install",
    "install-client": "cd frontend && npm install",
    "install-all": "npm run install-server && npm run install-client"
  },
  "keywords": [
    "mern",
    "sports",
    "booking",
    "venue"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  },
  "dependencies": {
    "@google/genai": "^1.42.0"
  }
}
